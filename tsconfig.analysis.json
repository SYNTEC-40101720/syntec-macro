{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/analysisProtocol.js",
    "src/analysisCore.js",
    "src/analysisHost.js",
    "scripts/benchmarkAnalysis.js"
  ],
  "exclude": ["node_modules"]
}
